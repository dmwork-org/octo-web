# Copy to ~/.config/octo-local-mac-packager.env and fill local values.
# Keep the copied file out of git.

# Runtime environment.
export VITE_API_URL="https://im.deepminer.com.cn"
export VITE_ENABLE_ENTERPRISE_SSO="true"

# Optional. Leave empty to let scripts/ci-enterprise-electron-build.sh discover
# sibling enterprise repositories automatically.
# macOS/Linux path delimiter is ":".
# export VITE_ENTERPRISE_MODULES_ENTRY="/path/to/octo-enterprise-modules/src/loop.ts"
# export VITE_ENTERPRISE_HTML_HEAD_PATH="/path/to/octo-enterprise-modules/html/head.html"

# Code signing. Prefer a certificate installed in the login keychain.
# Example:
# electron-builder will choose the Developer ID Application certificate type.
# Do not include the "Developer ID Application:" prefix here.
# export CSC_NAME="Company Name (TEAMID)"
# export CSC_IDENTITY_AUTO_DISCOVERY="false"

# Alternative certificate file flow, if needed later.
# export CSC_LINK="/absolute/path/to/developer-id-application.p12"
# export CSC_KEY_PASSWORD="change-me"

# Apple notarization API key flow.
# export APPLE_TEAM_ID="TEAMID"
# export APPLE_API_KEY_ID="KEYID"
# export APPLE_API_ISSUER="ISSUER-UUID"
# export APPLE_API_KEY="/absolute/path/to/AuthKey_KEYID.p8"

# Override the package command only when debugging.
# export OCTO_MAC_PACKAGE_COMMAND="corepack pnpm build-ele:enterprise:mac"
