gzip on;
gzip_min_length 1k;
gzip_disable msie6;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 2;
gzip_buffers 16 8k;
gzip_http_version 1.1;
gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;


server {
        listen       80;
        server_name  localhost;

        # Security headers
        # Prevent clickjacking attacks
        add_header X-Frame-Options "SAMEORIGIN" always;
        # Prevent MIME type sniffing
        add_header X-Content-Type-Options "nosniff" always;
        # Enable browser XSS filter (legacy but still useful)
        add_header X-XSS-Protection "1; mode=block" always;
        # Control referrer information sent with requests
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        # Content Security Policy - permissive to avoid breaking functionality
        # Note: 'unsafe-inline' and 'unsafe-eval' are needed for React/inline styles
        # blob: is required for srcdoc iframe previews (HTML file preview)
        # srcdoc iframe origin is null, so internally created blob URLs become blob:null/...
        # Adding blob: to script-src and connect-src allows these URLs to load.
        #
        # img-src: the object-store (minio) presign service signs image URLs over http://
        # on an environment-specific host:port (the browser-reachable minio host). CSP only
        # whitelists https: by default, so an http minio source is blocked at the CSP layer
        # (before even reaching the JS ASSET_HOST_WHITELIST). ${DOCS_ASSET_CSP_ORIGIN} is an
        # envsubst placeholder for that extra source (e.g. "http://192.168.214.189:9000"),
        # kept env-configurable so we never hardcode a host or open http: wide. It MUST match
        # the backend presign host and the frontend VITE_DOCS_ASSET_HOSTS value. Empty by
        # default (no extra source) for environments that serve assets over https.
        #
        # font-src: Excalidraw (whiteboard) loads its hand-drawn font faces (.woff2) from its
        # default asset host https://esm.sh when window.EXCALIDRAW_ASSET_PATH is not overridden
        # (e.g. https://esm.sh/@excalidraw/excalidraw@<ver>/dist/prod/fonts/...). Without it the
        # browser blocks the @font-face fetch and the console fills with CSP font-src errors.
        #
        # SECURITY NOTE (P2 #8, XIN-517): allowing esm.sh here is a scoped third-party origin —
        # limited to font-src only (never script/connect), so it cannot execute code or exfiltrate
        # data, but it is still a supply-chain surface. The preferred hardening is to SELF-HOST the
        # Excalidraw font assets and point window.EXCALIDRAW_ASSET_PATH at a same-origin path, then
        # drop esm.sh from font-src entirely. That requires copying @excalidraw/excalidraw's
        # dist/prod/fonts into the served bundle at build time (a new vite static-copy step in
        # apps/web) and cannot be validated while the whiteboard build/test env is frozen — shipping
        # it blind risks a silent production font break with no fallback once esm.sh is removed. Per
        # the boss escape hatch, esm.sh is retained for now; self-hosting is tracked as the
        # follow-up to remove this allowance.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: ${DOCS_ASSET_CSP_ORIGIN}; font-src 'self' data: https://esm.sh; connect-src 'self' ws: wss: http: https: blob:; media-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'self';" always;
        # HSTS - uncomment when full HTTPS chain is confirmed
        # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        resolver kube-dns.kube-system.svc.cluster.local valid=30s ipv6=off;
        resolver_timeout 5s;

        location /api/ {
            proxy_pass  ${API_URL}/;
            client_max_body_size 1000m;
            client_body_buffer_size 500m;
        }

        location = /version.json {
            root   /usr/share/nginx/html;
            add_header Cache-Control "no-store";
        }

        # OIDC SSO endpoints (authcode/authstatus/authorize/callback).
        # Backend mounts these under /v1/ directly (no /api/ prefix), so we
        # forward /v1/* without the strip-then-prepend dance the /api/ rule does.
        location /v1/ {
            proxy_pass  ${API_URL}/v1/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            client_max_body_size 10m;
        }

        location / {
            root   /usr/share/nginx/html;
            index  index.html index.htm;
        }
}
